generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String? // null for accounts created without one (e.g. Google sign-in)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("User")
}

model Settings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique
  userLangs String[]
}

model Phrase {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  authorId     String
  translations Json

  // Every read ("my phrases") filters on the author; without this MongoDB scans the whole collection.
  // Apply with `npx prisma db push` (Prisma does not create MongoDB indexes any other way).
  @@index([authorId])
}